{
  "schemaVersion": 1,
  "name": "bloc_cubit_base",
  "platform": "flutter",
  "rulesVersion": "1.0.0",
  "repository": "https://github.com/Peeky2000/bloc_cubit_base.git",
  "rules": [
    "AGENTS.md",
    ".agents/skills/project-convention/SKILL.md",
    "docs/architecture/README.md"
  ],
  "create": {
    "command": "derry new -- --destination {dest} --display-name {name} --package-name {package} --bundle-id {bundle}",
    "applyFlag": "--apply"
  },
  "gates": {
    "app": "./scripts/quality.sh",
    "componentLibrary": "./scripts/quality_sli_common.sh"
  },
  "components": {
    "skill": ".agents/skills/sli-kit-from-spec/SKILL.md",
    "libraryRoot": "lib/modules/sli_common",
    "kitTarget": "lib/modules/sli_common/lib/src/kit/{kit_snake}/v{version_snake}/",
    "goldenDir": "lib/modules/sli_common/test/goldens/kit/{kit}/{version}/",
    "goldenUpdate": "lib/modules/sli_common/scripts/update_goldens.sh",
    "goldenPlatform": "linux",
    "receipt": "lib/modules/sli_common/lib/src/kit/{kit_snake}/v{version_snake}/KIT-RECEIPT.json"
  },
  "featureFlow": ["/tech-design", "/build-feature"]
}
