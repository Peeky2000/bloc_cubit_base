{
  "command": "dart run perf",
  "scenario_directory": "integration_test/performance/scenarios",
  "routes_file": "lib/core/common/route.dart",
  "runs": 5,
  "warmup_runs": 1,
  "report_directory": "performance/reports",
  "history_file": "performance/history.jsonl",
  "baseline_directory": "performance/baselines",
  "thresholds": {
    "max_jank_percent": 3.0,
    "max_frame_p95_ms": 20.0,
    "max_frame_p99_ms": 32.0,
    "max_scenario_ms": 5000.0,
    "max_regression_percent": 5.0
  }
}
